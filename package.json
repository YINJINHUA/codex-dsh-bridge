{
  "name": "dsh-plugin-codex-project-bridge",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "description": "Codex 与 DeepSeek Harness 的本机项目通信桥。只登记项目，无需登记每个对话。通过私有 Unix socket 连接 DSH Host；返回 Codex 使用官方 CLI，以 stdio JSON-RPC 只读核验项目，再由 queue 投递消息。支持收发、状态与 DSH 最近结果，不使用模拟点击，不需要 API Key。入队不是任务完成，不自动重发。完整用法见 README.md。",
  "type": "module",
  "main": "plugin/index.mjs",
  "bin": { "codex-dsh-bridge": "bin/bridge.mjs" },
  "exports": { ".": "./plugin/index.mjs", "./package.json": "./package.json", "./locale/*": "./locale/*" },
  "files": ["plugin", "lib", "bin", "locale", "tests", "scripts", "docs", "README.md", "SECURITY.md", "CHANGELOG.md", "LICENSE", "cordis.patch.yml"],
  "engines": { "node": ">=22" },
  "scripts": { "test": "node --test tests/*.test.mjs", "check:release": "node scripts/check-release.mjs" },
  "dsh": { "bundle": { "patch": ["./cordis.patch.yml"] } }
}
